{
  // Assignment 2 hosted prototype. Separate Worker from Assignment 1 (cavli-assignment-1).
  "name": "cavli-assignment-2",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "DOCINTEL_SUPABASE_URL": "https://bxtofslencddcgxxsmaa.supabase.co",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "RETRIEVAL_DEFAULT": "hybrid",
    "GATE_DEFAULT": "model"
  }
  // Secrets (set with `wrangler secret put`): DOCINTEL_TOKEN, GEMINI_API_KEY, DEMO_ACCESS_SECRET
}

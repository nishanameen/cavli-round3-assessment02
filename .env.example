# Optional: enables generated answers. Leave empty for extractive mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional second key from another Google project; used only after a quota error (HTTP 429) on the first.
GEMINI_BACKUP_KEY=
# Hosted prototype only (python -m docintel publish / eval --hosted). Values are never committed.
DOCINTEL_SUPABASE_URL=
DOCINTEL_RUNTIME_TOKEN=
DOCINTEL_PUBLISH_TOKEN=
REVIEWER_PASSWORD=
